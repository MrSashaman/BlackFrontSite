@page
@model YourProject.Pages.Admin.ManagePostsModel

@{
    ViewData["Title"] = "Управление новостями";
}

<main>
    <section id="admin-posts">

        <h1>Панель администратора: Новости</h1>

        <hr />

        <div class="admin-create-post">

            <h2>Добавить новость</h2>

            <form method="post" enctype="multipart/form-data">

                <div class="mb-3">
                    <label asp-for="NewPost.Title">
                        Заголовок
                    </label>

                    <input asp-for="NewPost.Title"
                           class="form-control"
                           required />
                </div>
                <div class="mb-3">

                    <label asp-for="NewPost.CategoryId">
                        Категория
                    </label>

                    <select asp-for="NewPost.CategoryId"
                            class="form-control"
                            required>

                        <option value="">
                            — Выберите категорию —
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="NewPost.CategoryId"></span>

                </div>

                <div class="mb-3">
                    <label asp-for="NewPost.Content">Текст новости</label>
                    
                    <div class="file-upload-block" style="margin-bottom: 10px;">
                        <label for="file-input" style="cursor: pointer; color: #007bff; text-decoration: underline;">
                            Выбрать файл (.txt, .json, .docx, .pdf)
                        </label>
                        <input type="file" id="file-input" 
                            accept=".txt,.json,.pdf,.docx" 
                            style="display: none;" 
                            onchange="uploadFileAutomatically(this)" />
                        <span id="upload-status" style="margin-left: 10px; font-size: 0.9em;"></span>
                    </div>


                    





                    <textarea asp-for="NewPost.Content"
                            class="form-control"
                            rows="8"
                            required></textarea>

                    
                </div>
                <div class="admin-badge-selector">

                    <label>Редакционные значки</label>

                    <div class="badge-options">

                        @foreach (var badge in Model.Badges)
                        {
                            <label class="badge-checkbox">

                                <input type="checkbox"
                                    name="SelectedBadgeIds"
                                    value="@badge.Id" />

                                <span>
                                    @badge.Emoji @badge.Name
                                </span>

                            </label>
                        }

                    </div>
                    <div class="mb-3">
                        <label class="featured-checkbox">

                            <input asp-for="NewPost.IsFeatured"
                                type="checkbox" />

                            <span>● Избранное редакции</span>

                        </label>
                    </div>

                </div>
                <button type="submit" class="btn">
                    Опубликовать
                </button>

            </form>

        </div>


        <hr />


        <h2>Текущие новости</h2>

        @if (Model.Posts.Count == 0)
        {
            <p>Публикаций пока нет.</p>
        }
        else
        {
            <div class="admin-post-list">

                @foreach (var post in Model.Posts)
                {
                    <div class="admin-post">

                        <div class="admin-post-info">

                            <strong>
                            @post.Title
                            </strong>

                            <div class="admin-post-category">

                                @if (post.Category != null)
                                {
                                    @post.Category.Name
                                }
                                else
                                {
                                    <span>Без категории</span>
                                }

                            </div>

                            <div class="admin-post-date">
                                Создан:
                                @post.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd.MM.yyyy HH:mm")

                                @if (post.UpdatedAt.HasValue)
                                {
                                    <span>
                                        · Обновлён:
                                        @post.UpdatedAt.Value
                                            .ToLocalTime()
                                            .ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                }
                            </div>

                        </div>


                        <div class="admin-actions">

                            <a asp-page="/Admin/EditPost"
                               asp-route-id="@post.Id"
                               class="admin-edit">
                                Редактировать
                            </a>


                            <form method="post"
                                  asp-page-handler="Delete"
                                  asp-route-id="@post.Id"
                                  onsubmit="return confirm('Вы действительно хотите удалить публикацию «@post.Title»?');">

                                <button type="submit"
                                        class="admin-delete">
                                    Удалить
                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>
        }

    </section>
</main>

@section Scripts {
    <script src="~/js/ckeditor.js" asp-append-version="true"></script>
    <script src="~/js/admin-upload.js" asp-append-version="true"></script>
}
