@page "{id:int}"
@model YourProject.Pages.Admin.EditPostModel

@{
    ViewData["Title"] = "Редактирование публикации";
}

<main>
    <section id="edit-post">

        <h1>Редактирование публикации</h1>

        <hr />

        <form method="post">

            <input type="hidden"
                   asp-for="Input.Id" />


            <div class="mb-3">

                <label asp-for="Input.Title">
                    Заголовок
                </label>

                <input asp-for="Input.Title"
                       class="form-control"
                       required />

                <span asp-validation-for="Input.Title"></span>

            </div>

            <div class="mb-3">

                <label asp-for="Input.CategoryId">
                    Категория
                </label>

                <select asp-for="Input.CategoryId"
                        class="form-control">

                    <option value="">
                        — Выберите категорию —
                    </option>

                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="Input.CategoryId"></span>

            </div>
            <div class="mb-3">

                <label asp-for="Input.Content">
                    Текст публикации
                </label>

                <textarea asp-for="Input.Content"
                          class="form-control"
                          rows="15"
                          required></textarea>

                <span asp-validation-for="Input.Content"></span>

            </div>
            <div class="admin-badge-selector">

                <label>Редакционные значки</label>

                <div class="badge-options">

                    @foreach (var badge in Model.Badges)
                    {
                        bool selected =
                            Model.SelectedBadgeIds.Contains(badge.Id);

                        <label class="badge-checkbox">

                            <input type="checkbox"
                                name="SelectedBadgeIds"
                                value="@badge.Id"
                                checked="@selected" />

                            <span>
                                @badge.Emoji @badge.Name
                            </span>

                        </label>
                    }

                </div>

            </div>
            <div class="mb-3">

                <label class="featured-checkbox">

                    <input asp-for="Input.IsFeatured"
                        type="checkbox" />

                    <span> Избранное редакции</span>

                </label>

            </div>
            <div class="admin-actions">

                <button type="submit"
                        class="admin-save">
                    Сохранить
                </button>

                <a asp-page="/Admin/ManagePosts"
                   class="admin-cancel">
                    Отмена
                </a>

            </div>

        </form>

    </section>
</main>