@page
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting("login")]

@model YourProject.Pages.LoginModel

@{
    ViewData["Title"] = "Вход";
}


<div class="row justify-content-center mt-5">

    <div class="col-md-4">

        <div class="card">

            <div class="card-body">

                <h3 class="card-title text-center mb-4">
                    Вход
                </h3>


                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        @Model.ErrorMessage
                    </div>
                }


                <form method="post">

                    <div class="mb-3">

                        <label asp-for="Username"
                               class="form-label">
                            Логин
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               autocomplete="username"
                               required />

                    </div>


                    <div class="mb-3">

                        <label asp-for="Password"
                               class="form-label">
                            Пароль
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               autocomplete="current-password"
                               required />

                    </div>


                    <button type="submit"
                            class="btn btn-primary w-100">

                        Войти

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>