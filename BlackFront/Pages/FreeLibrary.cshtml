@page
@model FreeLibraryModel

@{
    ViewData["Title"] = "Библиотека - Черный фронт";
}

@section CustomNav {
    <nav class="main-nav">
        <ul>
            <li>
                <a asp-page="/Index"
                   asp-fragment="about"
                   class="nav-link">
                    Главная
                </a>
            </li>

            <li>
                <a asp-page="/News"
                   class="nav-link">
                    Новости
                </a>
            </li>

            <li>
                <a asp-page="/creation"
                   asp-fragment="about"
                   class="nav-link">
                    Творчество
                </a>
            </li>
        </ul>
    </nav>
}

<main>
    <section id="news">

        <h1>Вольная Библиотека</h1>
        <hr />
        
        <form method="get" class="news-search">
            <input type="text"
                   name="Search"
                   value="@Model.Search"
                   placeholder="Поиск по книгам, манифестам и авторам..."
                   class="news-search-input" />

            <button type="submit" class="news-search-button">
                Найти
            </button>
            
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <div class="search-info">
                    Результаты поиска по запросу:
                    <strong>@Model.Search</strong>

                    <a asp-page="/FreeLibrary" class="search-reset">
                        Сбросить
                    </a>
                </div>
            }
        </form>

        @if (Model.FeaturedBooks.Count > 0)
        {
            <div class="featured-section">

                <div class="news-section-title">
                    Избранный фонд движения
                </div>

                <div class="featured-list">

                    @foreach (var book in Model.FeaturedBooks)
                    {
                        <article class="featured-post">

                            <div class="news-category">
                                Автор: @book.Author
                            </div>

                            <h2 class="featured-title">
                                <a asp-page="/Book" asp-route-id="@book.Id">
                                    @book.Title
                                </a>
                            </h2>

                            <div class="library-cover-preview my-3" style="max-width: 200px; width: 100%; aspect-ratio: 3/4; overflow: hidden; border: 1px solid #e0e0e0; border-radius: 4px; background: #000;">
                                <img src="@book.GetDisplayCover()" 
                                    alt="@book.Title" 
                                    style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                            </div>



                            <div class="news-date">
                                Добавлено: @(book.AddedAt.ToLocalTime().ToString("dd.MM.yyyy"))
                            </div>
                            @{
                                var action = book.GetFileAction();
                            }

                            <div class="library-actions my-2 d-flex gap-2">
                                @if (action.IsDownload)
                                {
                                    <a href="@action.ActionUrl" download class="news-search-button text-decoration-none text-center d-block w-100 py-1" style="font-size: 0.85rem; background: #222;">
                                        Скачать файл
                                    </a>
                                }
                                else
                                {
                                    <a href="@action.ActionUrl" target="_blank" class="news-search-button text-decoration-none text-center d-block w-100 py-1" style="font-size: 0.85rem;">
                                        Прочитать
                                    </a>
                                }
                            </div>
                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-id="@book.Id" onsubmit="return confirm('Уничтожить этот труд из вольного фонда библиотеки?');" class="m-0">
                                    <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" style="font-size: 0.85rem; border-radius: 4px;">
                                        Удалить
                                    </button>
                                </form>
                            }


                        </article>
                    }

                </div>

            </div>
        }

        <div class="latest-section">

            <div class="news-section-title">
                Последние поступления литературы
            </div>

            @if (Model.LatestBooks.Count == 0)
            {
                <p>Других книг в фонде библиотеки пока нет.</p>
            }
            else
            {
                <div class="news-list">

                    @foreach (var book in Model.LatestBooks)
                    {
                        <article class="news-post">

                            <div class="news-category">
                                Автор: @book.Author
                            </div>

                            <h2 class="news-title">
                                <a asp-page="/Book" asp-route-id="@book.Id">
                                    @book.Title
                                </a>
                            </h2>

                            <div class="library-cover-preview my-3" style="max-width: 160px; width: 100%; aspect-ratio: 3/4; overflow: hidden; border: 1px solid #e0e0e0; border-radius: 4px; background: #000;">
                                <img src="@book.GetDisplayCover()" 
                                    alt="@book.Title" 
                                    style="width: 100%; height: 100%; object-fit: cover; display: block;" />

                            </div>



                            <div class="news-date">
                                Добавлено: @(book.AddedAt.ToLocalTime().ToString("dd.MM.yyyy"))
                            </div>

                        </article>
                    }

                </div>
            }

        </div>
        
    </section>
</main>
