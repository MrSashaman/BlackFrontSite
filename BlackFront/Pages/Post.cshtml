@page "{id:int}"
@model PostModel

@{
    ViewData["Title"] = Model.Post.Title + " - Черный фронт";
}

@section CustomNav {
    <nav class="main-nav">
        <ul>
            <li>
                <a asp-page="/Index"
                   asp-fragment="about"
                   class="nav-link">
                    Главная
                </a>
            </li>

            <li>
                <a asp-page="/News"
                   class="nav-link">
                    Новости
                </a>
            </li>

            <li>
                <a asp-page="/FreeLibrary"
                   asp-fragment="library"
                   class="nav-link">
                    Библиотека
                </a>
            </li>

            <li>
                <a asp-page="/creation"
                   asp-fragment="about"
                   class="nav-link">
                    Творчество
                </a>
            </li>
        </ul>
    </nav>
}

<main>
    <section id="post">

        <article class="post">
        
            @if (Model.Post.Category != null)
            {
                <div class="post-category">
                    @Model.Post.Category.Name
                </div>
            }

            <h1>@Model.Post.Title</h1>

            <div class="post-date">
                Опубликовано:
                @(Model.Post.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy"))
            </div>
            
            @if (Model.Post.UpdatedAt.HasValue)
            {
                <div class="post-updated">
                    Обновлено:
                    @(Model.Post.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy"))
                </div>
            }
            @if (Model.Post.PostBadges.Count > 0)
            {
                <div class="editorial-badges">

                    @foreach (var postBadge in Model.Post.PostBadges)
                    {
                        <span class="editorial-badge">
                            @postBadge.Badge.Emoji
                            @postBadge.Badge.Name
                        </span>
                    }

                </div>
            }
            
            <hr />

            <div class="post-content">
                @Model.Post.Content
            </div>

        </article>

        @if (Model.RecommendedPosts.Count > 0)
        {
            <aside class="recommendations-panel">

                <div class="recommendations-title">
                    По теме
                </div>

                <div class="recommendations-list">

                    @foreach (var recommended in Model.RecommendedPosts)
                    {
                        <article class="recommendation-item">

                            @if (recommended.Category != null)
                            {
                                <div class="recommendation-category">
                                    @recommended.Category.Name
                                </div>
                            }

                            <a asp-page="/Post"
                            asp-route-id="@recommended.Id"
                            class="recommendation-link">

                                @recommended.Title

                            </a>

                            <div class="recommendation-date">
                                @(recommended.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd.MM.yyyy"))
                            </div>

                        </article>
                    }

                </div>

            </aside>
        }
    </section>
</main>